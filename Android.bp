android_app {
    name: "PocketMode",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,

    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],

    static_libs: ["SettingsLib"],

    resource_dirs: [
        "res",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

}